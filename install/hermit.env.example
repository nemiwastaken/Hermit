# Installed instance config: /etc/hermit/hermit.env (mode 600, root).
# Written by install/install.sh; edit it there, never in the repo.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- LLM (OpenAI-compatible; DeepSeek by default) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_MAX_TOKENS=4096

# --- Paths: installed layout ---
DATABASE_PATH=/var/lib/hermit/hermit.db
SANDBOX_SOCKET=/srv/hermit/run/sandbox.sock
BEHAVIOR_DIR=/opt/hermit/behavior
