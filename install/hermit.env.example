# Installed instance config: /opt/hermit/hermit.env (mode 600, root).
# Written by install.sh; edit it there, never in the repo.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Answers private chats only, and only these user ids. Empty = nobody.
# The bot replies with your id if you write to it.
TELEGRAM_ALLOWED_USER_IDS=
# Old name, same number in a private chat. Kept so older configs keep working.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- LLM (OpenAI-compatible; DeepSeek by default) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_MAX_TOKENS=4096
# LLM_VISION=1  # Set only with a model that accepts image_url inputs.
# USD per 1M tokens; leave 0 to show tokens without a price.
# LLM_PRICE_IN_PER_M=0.14
# LLM_PRICE_OUT_PER_M=0.28

# --- Paths: installed layout ---
DATABASE_PATH=/opt/hermit/data/hermit.db
HERMIT_ATTACHMENTS_DIR=/opt/hermit/data/attachments
SANDBOX_SOCKET=/opt/hermit/run/sandbox/sandbox.sock
# Separate socket directories keep internet tools out of the offline sandbox.
NET_SOCKET=/opt/hermit/run/net/net.sock
BROWSER_SOCKET=/opt/hermit/run/browser/browser.sock
BEHAVIOR_DIR=/opt/hermit/behavior
