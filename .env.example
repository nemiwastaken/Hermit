# Local development config. Copy to .env, fill in, chmod 600. Never commit.
# For an installed instance use /opt/hermit/hermit.env instead (see install/).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. The bot refuses every other chat.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- LLM (OpenAI-compatible; DeepSeek by default) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_MAX_TOKENS=4096

# --- Paths: dev layout (everything next to the repo) ---
DATABASE_PATH=./.dev/hermit.db
SANDBOX_SOCKET=./.dev/run/sandbox.sock
BEHAVIOR_DIR=./.dev/behavior
